---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Showcase from "../components/Showcase.astro";
import ShowcaseIntro from "../components/ShowcaseIntro.astro";
import { getLocaleStaticPaths } from "../libs/page";
import { getSitesPage } from "../libs/showcase";

export const prerender = true;

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const page = getSitesPage();
---

<StarlightPage
  frontmatter={page.frontmatter}
  headings={[{ depth: 2, slug: "sites", text: "Sites" }]}
>
  <ShowcaseIntro
    cta={page.cta}
    href={page.editHref}
    emptyList={page.entries.length === 0}
  />

  {page.entries.length !== 0 && (
    <>
      <h2>Sites</h2>

      <p>
        {page.pluginLabel} is already being used in production. These are some
        of the sites around the web:
      </p>

      <Showcase entries={page.entries} />
    </>
  )}
</StarlightPage>
