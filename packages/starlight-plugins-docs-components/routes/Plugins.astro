---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import ResourcesIntro from "../components/ResourcesIntro.astro";
import ResourcesList from "../components/ResourcesList.astro";
import { getLocaleStaticPaths, getPluginsPage } from "../libs/page";

export const prerender = true;

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const page = await getPluginsPage();
---

<StarlightPage frontmatter={page.frontmatter} headings={page.headings}>
  <ResourcesIntro />
  <ResourcesList />
</StarlightPage>
