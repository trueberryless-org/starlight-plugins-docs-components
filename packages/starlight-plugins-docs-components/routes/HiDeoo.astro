---
import { Aside } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ResourcesIntro } from "@hideoo/starlight-plugins-docs-components";

import ResourcesList from "../components/ResourcesList.astro";
import { getHiDeooPage, getLocaleStaticPaths } from "../libs/page";
import { hideooResourcesUrl } from "../libs/resources";

export const prerender = true;

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const page = await getHiDeooPage();
---

<StarlightPage frontmatter={page.frontmatter} headings={page.headings}>
  <Aside>
    <p>
      We simply left this page as a thank you for{" "}
      <a href="https://github.com/HiDeoo">HiDeoo</a>. Be sure to check out the
      cool stuff below from this <strong>legendary guy</strong> 🙌!
    </p>
  </Aside>

  <ResourcesIntro />
  <ResourcesList resourcesUrl={hideooResourcesUrl} githubOrg="HiDeoo" />
</StarlightPage>
