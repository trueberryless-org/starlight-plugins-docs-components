---
import { getResourceSections } from "../libs/resources";
import Resources from "./Resources.astro";

interface Props {
  resourcesUrl?: string | undefined;
  githubOrg?: string | undefined;
}

const { resourcesUrl, githubOrg } = Astro.props;

const sections = await getResourceSections(resourcesUrl);
---

{sections.map(({ type, label }) => (
  <>
    <h2 id={type}>{label}</h2>
    <Resources {type} {resourcesUrl} {githubOrg} />
  </>
))}
